{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Offloader",
  "version": "0.2.0",
  "identifier": "com.jamespero.mediaoffloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Media Offloader",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#111015"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0NERCMjdERjc1NEFFNDEKUldSQnJsVDNmYkpORk0yV0lHQTh4eWgreTg0WUlRcXdUd2NrYUZnQ1VnNFNTL0NvNnR0b0ZMMHgK",
      "endpoints": [
        "https://github.com/jamespero/media-offloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
